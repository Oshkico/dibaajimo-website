 <form action="#" method="POST" class="space-y-6">

      <!-- Subject -->
      <div>
        <label
          for="subject"
          class="block text-sm font-medium text-gray-900"
        >
          Subject
        </label>

        <input
          type="text"
          id="subject"
          name="subject"
          placeholder="What is your inquiry about?"
          class="mt-2 block w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-1 focus:ring-black"
        />
      </div>

      <!-- Name / Number / Email -->

        <!-- Name -->
        <div>
          <label
            for="name"
            class="block text-sm font-medium text-gray-900"
          >
            Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            placeholder="Your name"
            class="mt-2 block w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-1 focus:ring-black"
          />
        </div>

        <!-- Email -->
        <div class="md:col-span-2">
          <label
            for="email"
            class="block text-sm font-medium text-gray-900"
          >
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            class="mt-2 block w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-1 focus:ring-black"
          />
        </div>


      <!-- Description -->
      <div>
        <label
          for="description"
          class="block text-sm font-medium text-gray-900"
        >
          Brief Description
        </label>

        <textarea
          id="description"
          name="description"
          rows="6"
          placeholder="Tell me a little about your project or inquiry..."
          class="mt-2 block w-full resize-y rounded-lg border border-gray-300 px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-1 focus:ring-black"
        ></textarea>
      </div>

      <!-- Submit -->
      <div>
        <button
          type="submit"
          class="w-full rounded-lg bg-black px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 md:w-auto"
        >
          Send Message
        </button>
      </div>

    </form>