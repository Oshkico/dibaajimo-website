  "main": "index.js",
  "scripts": {
    "build": "zola build && npx @tailwindcss/cli -i ./public/input.css -o ./public/style.css -m",
    "build-css": "npx @tailwindcss/cli -i ./public/input.css -o ./public/style.css -m",
    "build-cf-pages": "if [ \"$CF_PAGES_BRANCH\" = \"master\" ]; then zola build; else zola build --base-url $CF_PAGES_URL; fi",
    "serve": "start \"Zola\" cmd /c \"zola serve --interface 0.0.0.0\" && npx @tailwindcss/cli -i ./public/input.css -o ./public/style.css --watch",
    "test": "echo Error: no test specified && exit 1"
  },
